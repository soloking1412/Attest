# Cardano network the app publishes and verifies on
ATTEST_NETWORK=preview

# Blockfrost project id for that network
BLOCKFROST_PROJECT_ID=preview...

# KERIA agent, needed only to publish. Verification reads key event logs that
# are already published, so it works with these unset. Must be reachable from
# the deployed server, not localhost.
KERIA_URL=https://your-keria-host
KERIA_BOOT_URL=https://your-keria-boot-host

# Passcode controlling the agent. Losing it means no new attestations can be
# anchored under the identifiers it holds.
KERIA_PASSCODE=
