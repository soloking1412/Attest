{
  "name": "attest-cli",
  "version": "0.1.0",
  "description": "Command line tool for issuing and verifying Cardano contract attestations",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "attest": "./dist/main.js"
  },
