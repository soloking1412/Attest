      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@attest/blueprint": "workspace:*",
    "@attest/cardano": "workspace:*",
    "@attest/core": "workspace:*",
    "@attest/keri": "workspace:*",
    "@attest/verifier": "workspace:*"
  },
  "author": "Maheswaran Velmurugan <maheswar141203@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soloking1412/Attest.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/soloking1412/Attest#readme",
  "bugs": "https://github.com/soloking1412/Attest/issues"
